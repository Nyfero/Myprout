model resources {
  resource_id  Int       @id @default(autoincrement())

  // Relations
  user_id      Int
  user         users     @relation(fields: [user_id], references: [user_id])

  // Données
  title        String?
  note         String?   @db.Text

  // Statut
  is_active    Boolean   @default(false)

  // Horodatage
  created_at   DateTime  @default(now())
  updated_at   DateTime? @updatedAt
}
